{
  "name": "winmerge-report-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:integration": "vitest run --reporter=verbose tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --headed",
    "lint": "eslint js/",
    "lint:css": "stylelint \"*.css\"",
    "lint:all": "npm run lint && npm run lint:css",
    "sync:dompurify": "node scripts/sync-dompurify.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "js/**/*.js": [
      "eslint",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "dompurify": "^3.4.15"
  }
}
